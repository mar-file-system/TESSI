# the networks got to be a bit of a mess with all of the work I was doing trying to set up virtual bridges
# these commands are useful to clean up 

sudo cp -r /etc/sysconfig/network-scripts/ /etc/sysconfig/network-scripts.bak

sudo systemctl stop network NetworkManager
sudo systemctl disable NetworkManager
sudo rm -f /etc/sysconfig/network-scripts/ifcfg-*
sudo systemctl enable NetworkManager
sudo systemctl start NetworkManager
sudo nmcli connection add type ethernet ifname eno1 con-name eno1 ipv4.method auto
nmcli connection show
sudo nmcli connection delete br0
sudo nmcli connection delete virbr0
sudo nmcli connection delete virbr1
sudo nmcli connection delete "Wired connection 1"
sudo nmcli connection delete "Wired connection 2"
sudo nmcli connection delete "Wired connection 3"
sudo nmcli connection add type ethernet con-name eno1 ifname eno1 ipv4.method auto
sudo nmcli connection up eno1

# note: change the IP address here
sudo nmcli connection add type ethernet con-name eno1 ifname eno1 ipv4.method manual ipv4.addresses 172.16.0.7/24 ipv4.gateway 172.16.0.254 ipv4.dns 8.8.8.8

sudo ip link set eno2 down
sudo ip link set eno3 down
sudo ip link set eno4 down
sudo ip link set ib0 down

\rm /etc/NetworkManager/conf.d/ignore-eno1.conf 

# restart networkmanager
sudo systemctl restart NetworkManager


