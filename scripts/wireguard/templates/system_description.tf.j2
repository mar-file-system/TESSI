variable "vm_name" {
  type = list(object({
    name             = string
    machine          = optional(string, "{{ vm_defaults.machine }}")
    memory           = optional(string, "{{ vm_defaults.memory }}")
    vcpu             = optional(number, {{ vm_defaults.vcpu }})
    second_disk_size = optional(number, null)
    host             = string
    source_image     = optional(string, "{{ vm_defaults.server_image }}")
    storage_pool     = optional(string, "default")
    netone           = optional(string, "{{ vm_defaults.netone }}")
    nettwo           = optional(string, "{{ vm_defaults.nettwo }}")
    mac_address      = string
    cloudinit        = optional(string, "")
  }))       
  default = [
    {% for host, details in hostvars.items() if 'vms' in details %}
      {% for vm in details.vms %}
        {       
          name            = "{{ vm[0] }}"
          host            = "{{ host }}"
          {% if vm[2] != "none" %}
          second_disk_size = {{ vm[2] }}
          {% endif %}
          {% if vm[3] == 'client' %}
          source_image    = "{{ vm_defaults.client_image }}"
          {% endif %}
          mac_address     = "{{ consolidated_vm_mappings[vm[0]].mac }}"
          cloudinit       = <<EOT
#cloud-config
runcmd:
  - ip route add {{ wireguard.base_ip }}.0/{{ wireguard.cidr }} via {{ libvirt.base_ip }}.{{ hostvars[host].libvirt_first_address }}
{% for hostname, details in consolidated_vm_mappings.items() %}
  - echo "{{ details.ip }} {{ hostname }}" >> /etc/hosts
{% endfor %}
EOT
        },
      {% endfor %}
    {% endfor %}
  ]     
}

