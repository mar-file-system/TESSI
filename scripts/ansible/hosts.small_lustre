[all:vars]
ansible_user=root
ansible_ssh_common_args: '-o UserKnownHostsFile=/dev/null'

[small_lustre:children]
small_lustre_clients
small_lustre_servers

[small_lustre_clients]
client

[small_lustre_servers]
mds00
mds01
oss00
oss01

[small_lustre_clients:vars]
configure_args=--disable-server --enable-client

[small_lustre_servers:vars]
configure_args=--with-zfs --disable-ldiskfs --enable-server 
