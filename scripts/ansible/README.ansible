# run on all hosts
ansible-playbook -i hosts play.yaml

# just one group of hosts
ansible-playbook -i hosts2 get_status2.yaml --limit in16_vms

# just one single host
ansible-playbook -i hosts2 get_status2.yaml --limit in16vm01

# check available tags
ansible-playbook install_all.yaml --list-tags

# check connectivity
ansible all -m ping
