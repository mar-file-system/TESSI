# example instructions for working with virsh (libvirt, qemu, kvm)

# start and stop
sudo virsh start tassi02
sudo virsh shutdown tassi02

# clone
sudo virt-clone --original tassi02 --name tassi03 --auto-clone --nonsparse

# destroy a VM
virsh destroy tassi01
virsh undefine tassi01 --remove-all-storage --snapshots-metadata

# snapshot operations 
sudo virsh snapshot-create-as --domain my_vm --name my_snapshot --description "Snapshot of my VM" --disk-only --atomic
sudo virsh snapshot-revert --domain $vm_name --snapshotname $snap
virsh snapshot-delete [domain-name] [snapshot-name]

# network operations
virsh net-list --all

# console operations
virsh console [hostname]
disconnect with Ctrl+]
