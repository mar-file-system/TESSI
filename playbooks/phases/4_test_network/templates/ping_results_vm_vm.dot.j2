digraph ping_results {
    layout=circo; // Use the neato layout engine for a dynamic layout
    overlap=false; // Prevent overlapping nodes
    #splines=true; // Smooth edges for better aesthetics
    splines=curved; // splines is nice but makes it hard to see failures 
    nodesep=1.5; // Increase spacing between nodes
    ranksep=2.0; // Increase spacing between ranks
    outputorder=edgesfirst; // Draw edges before nodes to reduce overlap

    // Define edges for ping results
    {% for result in aggregated_ping_results %}
    "{{ result.src }}" -> "{{ result.dst }}" [
        color={{ "darkgreen" if result.success else "red" }},
        fontcolor={{ "darkgreen" if result.success else "red" }},
        penwidth=2
    ];
    {% endfor %}
}

