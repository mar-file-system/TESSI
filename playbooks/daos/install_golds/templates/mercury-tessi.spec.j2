# Local UCX-only build using DAOS's official Mercury patch series.
Name: mercury
Version: {{ daos_mercury_version }}
Release: {{ daos_mercury_release }}%{?dist}
Summary: Mercury RPC library with DAOS-18988 UCX endpoint cache fix
License: BSD-3-Clause
URL: https://mercury-hpc.github.io/
Source0: mercury-%{version}.tar.bz2
{% for patch in daos_mercury_patches %}
Patch{{ loop.index0 }}: {{ patch.name }}
{% endfor %}
Source7: build-provenance.json
BuildRequires: cmake, gcc-c++, boost-devel, ucx-devel, json-c-devel
%global debug_package %{nil}

%description
Mercury 2.4.1 with DAOS's pinned patch series, including the UCX packed-worker
address cache fix for DAOS-18988. Built for TESSI's UCX-only DAOS allocation.

%package ucx
Summary: Mercury UCX transport with DAOS-18988 fix
Requires: %{name}%{?_isa} = %{version}-%{release}
%description ucx
UCX transport plugin built against the installed validated DOCA UCX stack.

%package devel
Summary: Mercury development headers and libraries
Requires: %{name}%{?_isa} = %{version}-%{release}
%description devel
Development files matching the patched Mercury runtime.

%prep
%autosetup -p1 -n mercury-%{version}
grep -q na_ucx_worker_addr_map_lookup src/na/na_ucx.c

%build
%cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo \
       -DCMAKE_SKIP_INSTALL_RPATH=ON \
       -DBUILD_DOCUMENTATION=OFF -DBUILD_EXAMPLES=OFF \
       -DBUILD_TESTING=ON -DBUILD_TESTING_PERF=ON -DBUILD_TESTING_UNIT=OFF \
       -DMERCURY_ENABLE_DEBUG=ON -DMERCURY_USE_BOOST_PP=ON \
       -DMERCURY_USE_SYSTEM_BOOST=ON -DMERCURY_USE_CHECKSUMS=OFF \
       -DMERCURY_USE_XDR=OFF \
       -DMERCURY_INSTALL_DATA_DIR=%{_libdir} \
       -DMERCURY_INSTALL_LIB_DIR=%{_libdir} \
       -DNA_USE_DYNAMIC_PLUGINS=ON -DNA_INSTALL_PLUGIN_DIR=%{_libdir}/mercury \
       -DNA_USE_SM=ON -DNA_USE_UCX=ON -DNA_USE_OFI=OFF
%cmake_build

%install
%cmake_install
install -D -m 0644 %{SOURCE7} %{buildroot}%{_datadir}/doc/mercury-tessi/build-provenance.json

%post -p /sbin/ldconfig
%postun -p /sbin/ldconfig

%files
%license LICENSE.txt
%doc Documentation/CHANGES.md
%{_bindir}/hg_*
%{_bindir}/na_*
%{_libdir}/*.so.*
%{_datadir}/doc/mercury-tessi/

%files ucx
%{_libdir}/mercury/libna_plugin_ucx.so

%files devel
%{_includedir}/*
%{_libdir}/libmercury.so
%{_libdir}/libmercury_util.so
%{_libdir}/libna.so
%{_libdir}/pkgconfig/*.pc
%{_libdir}/cmake/

%changelog
* Tue Oct 27 2026 TESSI local build <nobody@localhost> - 2.4.1-3.1.tessi.daos18988
- Apply pinned DAOS Mercury patches 0001 through 0006, including DAOS-18988.
- UCX-only build; preserve the 2.4.1 shared-library ABI and runtime package names.
