# Managed by TESSI. Metadata on SSD; one engine per server.
name: daos_server
mgmt_svc_replicas: {{ daos_replicas | to_json }}
port: 10001
transport_config:
  allow_insecure: true
provider: {{ daos_provider }}
control_log_file: /var/log/daos/daos_server.log
control_metadata:
  path: /var/lib/daos
engines:
  - targets: {{ daos_targets }}
    nr_xs_helpers: 1
    pinned_numa_node: {{ daos_fabric_numa }}
    fabric_iface: {{ infiniband_device }}
    fabric_iface_port: 31416
    log_file: /var/log/daos/daos_engine.0.log
    log_mask: INFO
    storage:
      - class: ram
        scm_mount: /mnt/daos_scm
        scm_size: {{ daos_scm_size }}
      - class: nvme
        bdev_list: {{ daos_pci_addresses | to_json }}
        bdev_roles: [wal, meta, data]
