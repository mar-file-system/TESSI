digraph IORResults {
  label = "IOR Results for {{ fstype }}";
  labelloc = "t";
  fontsize = 24;
  rankdir = TB;

  // Clients
  subgraph cluster_clients {
    label = "Clients";
    style = filled;
    color = lightblue;
    rank = same;
    {% for client in groups['clients'] %}
    "{{ client }}" [shape=box];
    {% endfor %}
    {% for pair in groups['clients'] | batch(2) %}
      {% if pair | length == 2 %}
      "{{ pair[0] }}" -> "{{ pair[1] }}" [style=invis];
      {% endif %}
    {% endfor %}
  }

  // IOR Results
  subgraph cluster_results {
    label = "IOR Results";
    style = filled;
    color = lightyellow;
    {% for result in ior_results %}
    subgraph cluster_{{ result.mpi_module | regex_replace('[^A-Za-z0-9]', '_') }} {
      label = "{{ result.mpi_module }}";
      style = dashed;
      color = lightgreen;

      "{{ result.mpi_module }}_write" [
        label = "Write\n{{ result.write_bw }} MiB/s",
        shape = note,
        color = "{{ 'green' if result.status == 'success' else 'red' }}"
      ];

      "{{ result.mpi_module }}_read" [
        label = "Read\n{{ result.read_bw }} MiB/s",
        shape = note,
        color = "{{ 'green' if result.status == 'success' else 'red' }}"
      ];
    }
    {% endfor %}
  }

  // Servers
  subgraph cluster_servers {
    label = "Servers";
    style = filled;
    color = lightgray;
    rank = same;
    {% for group in ['mds', 'oss'] %}
      {% for host in groups[group] %}
      "{{ host }}" [shape=ellipse];
      {% endfor %}
    {% endfor %}
    {% set all_servers = (groups['mds'] + groups['oss']) %}
    {% for pair in all_servers | batch(2) %}
      {% if pair | length == 2 %}
      "{{ pair[0] }}" -> "{{ pair[1] }}" [style=invis];
      {% endif %}
    {% endfor %}
  }
}

