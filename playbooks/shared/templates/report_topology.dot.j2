// Bare-metal adaptation of phases/4_test_network/templates/network_graph.dot.j2.
// Group clusters and a logical shared fabric; switch topology is not discovered.
digraph Performance_Network {
    graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.28", ranksep="0.7",
           fontname="Helvetica", compound=true];
    node [shape=box, style="rounded,filled", color="#cad4df", fillcolor="#f4f7fb",
          fontname="Helvetica", fontsize=11, margin="0.15,0.12"];
    edge [color="#7295b5", penwidth=1.3, dir=none];
    fabric [label={{ manifest.topology_fabric_label | default('InfiniBand fabric\nOpen MPI / UCX RDMA') | tojson }}, shape=ellipse,
            fillcolor="#e2eff7", color="#2c718e", fontsize=13];
    {% for group in ['clients', 'ds', 'mds'] if manifest.groups.get(group, []) %}
    subgraph cluster_{{ group }} {
        label={{ (group ~ ' | ' ~ (manifest.groups[group] | length | string) ~ ' nodes') | tojson }};
        style="rounded"; color="#89a9bf"; fontname="Helvetica-Bold"; fontsize=14;
        {% for host in manifest.groups[group] if group != 'mds' or host not in manifest.groups.get('ds', []) %}
        {% set h = manifest.hosts[host] %}
        {{ host | tojson }} [label={{ (host.split('.')[0] ~ (' [DS + MDS]' if host in manifest.groups.get('ds', []) and host in manifest.groups.get('mds', []) else '') ~ '\n' ~ h.fqdn ~ '\n' ~ h.ib_device ~ ': ' ~ h.ib_address ~ ('\n' ~ (h.fio.devices | length | string) ~ ' SSDs' if h.fio.devices is defined and h.fio.devices else '')) | tojson }}];
        {% endfor %}
    }
    {% endfor %}
    {% for host in manifest.groups.clients %}
    {{ host | tojson }} -> fabric;
    {% endfor %}
    {% for group in ['ds', 'mds'] %}
    {% for host in manifest.groups.get(group, []) if group != 'mds' or host not in manifest.groups.get('ds', []) %}
    fabric -> {{ host | tojson }};
    {% endfor %}
    {% endfor %}
}
