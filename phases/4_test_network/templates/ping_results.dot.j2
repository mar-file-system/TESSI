// Jinja2 Template for Ping Results DOT Graph
digraph PingResults {
    rankdir=LR; // Left-to-right layout
    node [shape=ellipse];

    // Define subgraphs for hosts
    {% for host in groups['physical_hosts'] %}
      {% set host_data = hostvars[host] %}
      subgraph cluster_{{ host }} {
          // label = "{{ host }}"; // just label the nodes because their IP node effectively labels them
          style = filled;
          color = lightgrey;

          {% for ip, label in host_data.ip_to_label_map.items() %}
          "{{ ip }}" [label="{{ label }}"];
          {% endfor %}
      }
    {% endfor %}

    // Define edges for ping results
    {% for result in aggregated_ping_results %}
    "{{ result.src }}" -> "{{ result.dst }}" [
        color={{ "darkgreen" if result.success else "red" }},
        // label="{{ "Success" if result.success else "Failure" }}", // the lines are clear w/ red/green so don't need labels
        fontcolor={{ "darkgreen" if result.success else "red" }},
        penwidth=2
    ];
    {% endfor %}
}

