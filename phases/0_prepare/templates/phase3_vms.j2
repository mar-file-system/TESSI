{% include 'header.j2' %}
vm_name = [
{% for vm in vm_info %}
  {
    name             = "{{ vm.name }}"
    host             = "{{ vm.physical_host }}"
    mac_address      = "{{ vm.mac_address }}"
    machine          = "{{ vm.machine }}"
    memory           = "{{ vm.memory }}"
    netone           = "{{ vm.netone }}"
    nettwo           = "{{ vm.nettwo }}"
    {% if vm.hdd2_size != "none" and vm.hdd2_size|int != 0 %}
    second_disk_size = "{{ vm.hdd2_size }}"
    {% endif %}
    source_image     = "{{ vm.source_image }}"
    storage_pool     = "{{ vm.storage_pool }}"
    vcpu             = "{{ vm.vcpu }}"
    cloudinit        = <<EOT
#cloud-config
hostname: {{ vm.name }}
preserve_hostname: false
hostname:  {{ vm.name }}
fqdn: {{ vm.name }}.{{ UNIQUE_TAG }}.tassi.local

write_files:
  - path: /etc/systemd/system/add-static-route.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Add static route for {{ network.wireguard.base_ip }}.0/{{ network.wireguard.cidr }} via {{ vm.libvirt_bridge }}
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/sbin/ip route add {{ network.wireguard.base_ip }}.0/{{ network.wireguard.cidr }} via {{ vm.libvirt_bridge }}
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - hostnamectl set-hostname {{ vm.name }}
  - systemctl daemon-reload
  - systemctl enable add-static-route.service
  - systemctl start add-static-route.service
  - echo "nameserver {{ vm.libvirt_bridge }}" >> /etc/resolv.conf
{% for inner_vm in vm_info %}
  - echo "{{ inner_vm.ansible_host }} {{ inner_vm.name }}" >> /etc/hosts
{% endfor %}
EOT
  },
{% endfor %}
]
