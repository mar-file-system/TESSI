{# Jinja2 template to generate a Makefile for the Tassi workflow (excluding prepare) #}
{% include 'header.j2' %}
{# ------------------------------------------------------------------------------------ #}
{# Define the phases and their commands #}
{% set phases = [
    { 
      'name': 'phase1',
      'dir': '1_make_golds',
      'clean': 'ansible-playbook -i $(INVENTORY) tassi_phase1_create_gold_vms.yaml --tags makeclean',
      'create': 'ansible-playbook -i $(INVENTORY) tassi_phase1_create_gold_vms.yaml',
      'help': 'Phase 1: Create gold VMs and stash them as qcow2 images',
      'helpclean': 'Delete the gold VMs and their qcow2 images'
    },
    { 
      'name': 'phase2',
      'dir': '2_create_network',
      'clean': 'ansible-playbook -i $(INVENTORY) tassi_phase2_create_networks.yaml --tags makeclean',
      'create': 'ansible-playbook -i $(INVENTORY) tassi_phase2_create_networks.yaml',
      'help': 'Phase 2: Create and configure the wireguard tunnels, the libvirt bridges, and update /etc/hosts',
      'helpclean': 'Remove the wireguard tunnels, the libvirt bridges, and the updates in /etc/hosts'
    },
    { 
      'name': 'phase3',
      'dir': '3_create_cluster',
      'clean': 'tofu destroy -var-file $(TFVARS) --auto-approve',
      'create': 'tofu apply -var-file $(TFVARS) --auto-approve',
      'help': 'Phase 3: Create VMs from the stashed gold images',
      'helpclean': 'Remove the VMs and free all their associated resources'
    },
    { 
      'name': 'phase4',
      'dir': '4_test_network',
      'clean': 'ansible-playbook -i $(INVENTORY) tassi_phase4_test_network.yaml --tags makeclean',
      'create': 'ansible-playbook -i $(INVENTORY) tassi_phase4_test_network.yaml',
      'help': 'Phase 4: Debug the network and produce some graphs',
      'helpclean': 'Remove the network graphs'
    }
] %}

.PHONY: help all clean {% for phase in phases %}{{ phase.name }} {{ phase.name }}-clean {% endfor %}

# Define common variables (adjust paths as needed)
ARTIFACTS := {{ artifact_dir }}
INVENTORY := $(ARTIFACTS)/inventory
TFVARS := $(ARTIFACTS)/phase3_vms.tfvars
PHASE_DIR := {{ playbook_dir }}/..

help:
	@echo "Available targets:"
	@echo "  all           - Run the entire TASSI workflow for {{ UNIQUE_TAG }}"
	@echo "  clean         - Clean the entire TASSI workflow for {{ UNIQUE_TAG }} (in reverse order)"
{% for phase in phases %}
	@echo "  {{ phase.name }}        - {{ phase.help }}"
{% endfor %}
{% for phase in phases %}
	@echo "  {{ phase.name }}-clean  - {{ phase.helpclean }}"
{% endfor %}

# The "all" target runs the creation commands for all phases (in order)
all: {% for phase in phases %}{{ phase.name }} {% endfor %}

	@echo "All phases created!"

# The "clean" target runs the clean commands in reverse order
clean: {% for phase in phases | reverse %}{{ phase.name }}-clean {% endfor %}

	@echo "All phases cleaned!"

{# Define individual phase targets. Each target changes into its directory, echoes a message, and runs the appropriate command with sudo. #}
{% for phase in phases %}
{{ phase.name }}:
	@echo "==> Creating phase: {{ phase.name }}"
	@cd $(PHASE_DIR)/{{ phase.dir }} && sudo bash -c '{{ phase.create }}'

{{ phase.name }}-clean:
	@echo "==> Cleaning phase: {{ phase.name }}"
	@cd $(PHASE_DIR)/{{ phase.dir }} && sudo bash -c '{{ phase.clean }}'

{% endfor %}

