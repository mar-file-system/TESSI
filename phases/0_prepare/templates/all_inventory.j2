{% include 'header.j2' %}
all:
  vars:
    UNIQUE_TAG: {{ UNIQUE_TAG }}
  children:
    default:
      children:
        physical_hosts:
    physical_hosts:
      hosts:
{% for host in groups['all'] %}
        {{ host }}:
          wireguard_ip: "{{ network.wireguard.base_ip}}.{{ hostvars[host].wireguard_suffix }}"
          libvirt_addresses: "{{ network.libvirt.base_ip }}.{{ hostvars[host].libvirt_suffix }}/{{ network.libvirt.cidr }}"
          vms:
{% for vm in hostvars[host].vms | default([]) %}
            - "{{ vm[0] }}"
{% endfor %}
{% endfor %}
vms:
  hosts:
{% for vm in vm_info %}
    {{ vm.name }}:
      ansible_host: "{{ vm.ansible_host }}"
      group: "{{ vm.group }}"
      hdd1_size: "{{ vm.hdd1_size }}"
      hdd2_size: "{{ vm.hdd2_size }}"
      mac_address: "{{ vm.mac_address }}"
      physical_host: "{{ vm.physical_host }}"
{% endfor %}
