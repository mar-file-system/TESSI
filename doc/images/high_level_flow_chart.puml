@startuml
!define RECTANGLE "rectangle"
!define DIAMOND "diamond"
!define ARROW "arrow"

' Define participants
participant "Bootstrap VM\nCheck/Create" as Bootstrap
participant "Check Gold Image\nCheck/Create" as GoldImage
participant "Clone Gold Image\nInto VMs" as Clone
participant "Configure System\n(Lustre, Clients)" as Configure
participant "Run Test Script" as Test
participant "Push Output to Lustre" as PushOutput

' Define states
state "Bootstrap VM\n(State: Present)" as BootstrapState
state "Gold Image\n(State: Present)" as GoldImageState
state "VMs\n(State: Cloned)" as VMsState

' High-Level Flowchart
Bootstrap --> GoldImage: Check
GoldImage --> Clone: Check
Clone --> Configure: Configure
Configure --> Test: Run
Test --> PushOutput: Push

' States
Bootstrap --> BootstrapState: Create
GoldImage --> GoldImageState: Create
Clone --> VMsState: Clone

@enduml

