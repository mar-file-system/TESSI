digraph G {
    rankdir=LR; // Set the direction of the graph to Left-to-Right
    nodesep=0.5; // Increase the separation between nodes
    ranksep=0.5; // Increase the separation between ranks

    // Define subgraph cluster1
    subgraph cluster1 {
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        label = "Ansible Playbooks";
        labelloc = "t";

        Install -> Configure -> Test [style=invis];
    }

    // Define subgraph cluster2
    subgraph cluster2 {
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        label = "Virtual Machines";
        labelloc = "b";

        bootstrap [label=Bootstrap,color=yellow,shape=rectangle];
        bootstrap -> gold -> cluster [style=invis];

        gold [shape=plaintext, label=<
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
                <TR>
                    <TD bgcolor='Bisque' PORT="client">client</TD>
                </TR>
                <TR>
                    <TD bgcolor='BurlyWood' PORT="server">server</TD>
                </TR>
                <TR>
                    <TD COLSPAN="1">Gold Images</TD>
                </TR>
            </TABLE>
        >];

        // Define the rectangle for 'cluster' with three rows
        cluster [shape=plaintext, label=<
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
                <TR>
                    <TD bgcolor='Bisque' PORT="c0">c0</TD>
                    <TD bgcolor='Bisque' PORT="c1">c1</TD>
                    <TD PORT="...">...</TD>
                    <TD bgcolor='Bisque' PORT="cN">cN</TD>
                </TR>
                <TR>
                    <TD bgcolor='BurlyWood' PORT="mgt">mgt</TD>
                    <TD bgcolor='BurlyWood' PORT="m0">m0</TD>
                    <TD PORT="...">...</TD>
                    <TD bgcolor='BurlyWood' PORT="mN">mN</TD>
                </TR>
                <TR>
                    <TD COLSPAN="4">Cluster</TD>
                </TR>
            </TABLE>
        >];
    }

    /*
    // Define subgraph cluster3
    subgraph cluster3 {
        style=filled;
        color=lightgrey;
        node [style=filled,color=white];
        label = "TASSI Control Agent";

        A3 -> B3 -> C3;
    }
    */

    // hidden lines to try to get alignment right
    //bootstrap -> Install [style=invis];

    // now show how the cloning works
    bootstrap -> gold [label="1) clone"];
    gold -> cluster [label="3) clone"];

    // now show how the ansible playbooks work
    Install -> gold [label="2)"];
    Configure -> cluster [label="4)"];

    Test -> cluster [label="5)"];
    
    // Align clusters horizontally
    // { rank=same; cluster cluster3 cluster1; }
}

