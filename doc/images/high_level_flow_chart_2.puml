@startuml
!define RECTANGLE "rectangle"
!define ARROW "arrow"

' Define nodes
node "Bootstrap VM\nCheck/Create" as Bootstrap {
  [Bootstrap VM\n(State: Present)]
}
node "Check Gold Image\nCheck/Create" as GoldImage {
  [Gold Image\n(State: Present)]
}
node "Clone Gold Image\nInto VMs" as Clone {
  [VMs\n(State: Cloned)]
}
node "Configure System\n(Lustre, Clients)" as Configure
node "Run Test Script" as Test
node "Push Output to Lustre" as PushOutput

' Define edges
Bootstrap -down-> BootstrapState
GoldImage -down-> GoldImageState
Clone -down-> VMsState

Bootstrap -right-> GoldImage: Check
GoldImage -right-> Clone: Check
Clone -down-> Configure: Configure
Configure -down-> Test: Run
Test -down-> PushOutput: Push

@enduml

