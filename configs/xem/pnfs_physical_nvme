# note that the physical nodes are expected to be ubuntu 24.04
all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    experiment_dir: 'proj/mvpnet/jbent/experiments'
    local_storage: /mnt/local
    network:
      type: 'none'
    output_dir: "/tmp/{{ current_user }}/experiments" 
    playbooks:
      bootstrap_cluster: "./playbooks/shared/prereqs.yaml"
      gold_install: "./playbooks/pnfs/install_golds/install_pnfs_all.yaml"  
      cluster_config: "./playbooks/pnfs/configure_cluster/configure_pnfs_all.yaml"
      cluster_test: "./playbooks/shared/io500_tester.yaml" # this one is optional
    system:
      type: 'pnfs'
      version: 'xx'
      pnfs_src: '/proj/mvpnet/pnfs-lattice/'
      rondb_url: 'https://repo.hops.works/master/rondb-26.02.4-linux-glibc2.28-x86_64.tar.gz'
    UNIQUE_TAG: "pmanual"

  children:
    physical_hosts:
      children:
        mds:
          hosts:
            h0.ubuntu2.mvpnet:
            h1.ubuntu2.mvpnet:
            h2.ubuntu2.mvpnet:
            h3.ubuntu2.mvpnet:
        ds:
          hosts:
            h4.ubuntu2.mvpnet:
            h5.ubuntu2.mvpnet:
            h6.ubuntu2.mvpnet:
            h7.ubuntu2.mvpnet:
        clients:
          hosts:
            h9.ubuntu2.mvpnet:
            h10.ubuntu2.mvpnet:
            h11.ubuntu2.mvpnet:
            h12.ubuntu2.mvpnet:
            h13.ubuntu2.mvpnet:
            h14.ubuntu2.mvpnet:
            h15.ubuntu2.mvpnet:
            h16.ubuntu2.mvpnet:
            h17.ubuntu2.mvpnet:
