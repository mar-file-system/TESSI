all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    host_domain: "lustre-{{ current_user }}.mvpnet"
    result_dir: "/proj/mvpnet/{{ current_user }}/experiments"
    output_dir: "/proj/mvpnet/{{ current_user }}/tessi-artifacts"
    network:
      type: 'none'
    playbooks:
      bootstrap_cluster: "./playbooks/shared/prereqs.yaml"
      gold_install: "./playbooks/lustre/install_golds/install_lustre_all.yaml"
      cluster_config: "./playbooks/lustre/configure_cluster/configure_lustre_all.yaml"
      cluster_test: "./playbooks/shared/io500_tester.yaml"
    system:
      type: 'lustre'
      version: '2.15.7'
      loglevel: '5'
      lnet_transport: 'o2ib'
      failover: false
    io500:
      stonewall_time: 30
      ppn: 16
      mpi_modules:
        - mpi/openmpi-x86_64
    phase5_inventory_host_vars:
      - local_storage_devices
      - lustre_mgs_disk
    UNIQUE_TAG: "lbig"

  children:
    physical_hosts:
      vars:
        ansible_host: "{{ inventory_hostname }}.{{ host_domain }}"
      children:
        mds:
          vars: &lustre_storage
            local_storage_mode: raw-devices
            local_storage_devices:
              - /dev/nvme0n1
              - /dev/nvme1n1
              - /dev/nvme2n1
              - /dev/nvme3n1
              - /dev/nvme4n1
          hosts:
            mds0:
              lustre_mgs_disk: /dev/nvme0n1
            mds1:
            mds2:
            mds3:
        oss:
          vars: *lustre_storage
          hosts:
            oss0:
            oss1:
            oss2:
            oss3:
            oss4:
            oss5:
            oss6:
            oss7:
            oss8:
            oss9:
        clients:
          hosts:
            cli0:
            cli1:
            cli2:
            cli3:
            cli4:
            cli5:
            cli6:
            cli7:
            cli8:
            cli9:
