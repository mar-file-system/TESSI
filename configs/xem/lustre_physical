# note that this expects to run on rocky 9
all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    network:
      type: 'none'
    output_dir: "/proj/mvpnet/{{ current_user }}/experiments" 
    playbook_base: "/proj/mvpnet/{{ current_user }}/TESSI/playbooks"
    playbooks:
      prepare_cluster: "{{ playbook_base }}/shared/prereqs.yaml"
      gold_install: "{{ playbook_base }}/lustre/install_golds/install_lustre_all.yaml"  
      cluster_config: "{{ playbook_base }}/lustre/configure_cluster/configure_lustre_all.yaml"
      cluster_test: "{{ playbook_base }}/shared/ior_tester.yaml" # this one is optional
    system:
      type: 'lustre'
      version: '2.15.4'
      loglevel: '5'
    UNIQUE_TAG: "lmanual"

  children:
    physical_hosts:
      children:
        mds:
          hosts:
            tessi0.rocky.mvpnet:
            tessi3.rocky.mvpnet:
            tessi4.rocky.mvpnet:
            tessi5.rocky.mvpnet:
        oss:
          hosts:
            tessi1.rocky.mvpnet:
            tessi6.rocky.mvpnet:
            tessi7.rocky.mvpnet:
            tessi8.rocky.mvpnet:
        clients:
          hosts:
            tessi2.rocky.mvpnet:
            tessi9.rocky.mvpnet:
            tessi10.rocky.mvpnet:
            tessi11.rocky.mvpnet:
            tessi12.rocky.mvpnet:
            tessi13.rocky.mvpnet:

