# note that the physical nodes are expected to be ubuntu 24.04
all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    network:
      type: 'none'
    output_dir: "/proj/mvpnet/{{ current_user }}/experiments" 
    playbook_base: "/proj/mvpnet/{{ current_user }}/TESSI/playbooks"
    playbooks:
      bootstrap_cluster: "{{ playbook_base }}/shared/prereqs.yaml"
      gold_install: "{{ playbook_base }}/pnfs/install_golds/install_pnfs_all.yaml"  
      cluster_config: "{{ playbook_base }}/pnfs/configure_cluster/configure_pnfs_all.yaml"
      cluster_test: "{{ playbook_base }}/shared/ior_tester.yaml" # this one is optional
    system:
      type: 'pnfs'
      version: 'xx'
      pnfs_src: '/proj/mvpnet/pnfs-lattice/'
      rondb_url: 'https://repo.hops.works/master/rondb-24.10.0-linux-glibc2.28-x86_64.tar.gz'
    UNIQUE_TAG: "pmanual"

  children:
    physical_hosts:
      children:
        mds:
          hosts:
            h0.ubuntu.mvpnet:
            h3.ubuntu.mvpnet:
            h4.ubuntu.mvpnet:
            h5.ubuntu.mvpnet:
        ds:
          hosts:
            h1.ubuntu.mvpnet:
            h6.ubuntu.mvpnet:
            h7.ubuntu.mvpnet:
            h8.ubuntu.mvpnet:
        clients:
          hosts:
            h2.ubuntu.mvpnet:
            h9.ubuntu.mvpnet:
            h10.ubuntu.mvpnet:
            h11.ubuntu.mvpnet:
            h12.ubuntu.mvpnet:
            h13.ubuntu.mvpnet:
            h14.ubuntu.mvpnet:
            h15.ubuntu.mvpnet:
            h16.ubuntu.mvpnet:
            h17.ubuntu.mvpnet:
