all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    network:
      type: 'none'
    output_dir: "/proj/mvpnet/{{ current_user }}/experiments" 
    playbook_base: "/proj/mvpnet/{{ current_user }}/TESSI/playbooks"
    playbooks:
      prepare_cluster: "{{ playbook_base }}/shared/prereqs.yaml"
      gold_install: "{{ playbook_base }}/pnfs/install_golds/install_pnfs_all.yaml"  
      cluster_config: "{{ playbook_base }}/pnfs/configure_cluster/configure_pnfs_all.yaml"
      cluster_test: "{{ playbook_base }}/shared/ior_tester.yaml" # this one is optional
    system:
      type: 'pnfs'
      version: 'xx'
      pnfs_src: '/proj/mvpnet/pnfs-lattice/'
      rondb_url: 'https://repo.hops.works/master/rondb-24.10.0-linux-glibc2.28-x86_64.tar.gz'
    UNIQUE_TAG: "pmanual"

  children:
    physical_hosts:
      children:
        mds:
          hosts:
            tessi0.ubuntu.mvpnet:
            tessi3.ubuntu.mvpnet:
            tessi4.ubuntu.mvpnet:
            tessi5.ubuntu.mvpnet:
        ds:
          hosts:
            tessi1.ubuntu.mvpnet:
            tessi2.ubuntu.mvpnet:
            tessi6.ubuntu.mvpnet:
            tessi7.ubuntu.mvpnet:
        clients:
          hosts:
            tessi8.ubuntu.mvpnet:
