# note that the physical nodes are expected to be ubuntu 24.04
all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    host_domain: "{{ current_user }}.mvpnet"
    result_dir: '/proj/mvpnet/{{ current_user }}/experiments'
    local_storage: /mnt/local
    network:
      type: 'none'
    output_dir: "/tmp/{{ current_user }}/experiments" 
    playbooks:
      bootstrap_cluster: "./playbooks/shared/prereqs.yaml"
      gold_install: "./playbooks/pnfs/install_golds/install_pnfs_all.yaml"  
      cluster_config: "./playbooks/pnfs/configure_cluster/configure_pnfs_monolithic.yaml"
      cluster_test: "./playbooks/shared/io500_tester.yaml" # this one is optional
    system:
      type: 'pnfs'
      version: 'xx'
      pnfs_src: '/proj/mvpnet/jbent/pnfs-lattice/'
      rondb_url: 'https://repo.hops.works/master/rondb-26.02.4-linux-glibc2.28-x86_64.tar.gz'
      ds_transport: 'rdma' # can be rdma or tcp
      client_mds_assignment: 'round-robin' # can be first or round-robin
      stripe_width: "{{ groups['ds'] | length }}"
      stripe_size: 1048576
      hpc_serve_layouts: true
    io500:
      stonewall_time: 300
      ppn: 8
      result_metadata:
        mdsassign: "{{ system.client_mds_assignment }}"
      data_directory_xattrs:
        - name: user.pnfs.hpc_shared
          value: "{{ '1' if system.stripe_width | int > 1 else '0' }}"
    UNIQUE_TAG: "pmanual"

  children:
    physical_hosts:
      vars:
        ansible_host: "{{ inventory_hostname }}.{{ host_domain }}"
      children:
        ds:
          hosts:
            ds0:
            ds1:
            ds2:
            ds3:
            ds4:
            ds5:
            ds6:
            ds7:
            ds8:
            ds9:
        clients:
          hosts:
            cli0:
            cli1:
            cli2:
            cli3:
            cli4:
            cli5:
            cli6:
            cli7:
            cli8:
            cli9:
        mds:
          hosts:
            mds0:
            mds1:
            mds2:
            mds3:
