all:

  vars:
    current_user: "{{ lookup('env', 'USER') }}"

    # suppress ssh annoyance
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

    # define a tag for this system to avoid collisions (e.g. on the gold VM images or the networking)
    UNIQUE_TAG: "xemlmvp"

    # optional directory into which to create the TASSI workflow (defaults to pwd/artifacts/UNIQUE_TAG)
    #output_dir: "/proj/mvpnet/{{ current_user }}/experiments" # use tmp because the home dir has root squash
    output_dir: "/tmp/{{ current_user }}/experiments" # use tmp because the home dir has root squash

    # define paths to user-custom playbooks used in the 'install gold VMs' phase and the 'configure cluster' phase 
    #playbook_base: "/proj/mvpnet/{{ current_user }}/TESSI/playbooks"
    playbook_base: "/tmp/TESSI/playbooks"
    playbooks:
      bootstrap_cluster: "{{ playbook_base }}/shared/prereqs.yaml"
      gold_install: "{{ playbook_base }}/lustre/install_golds/install_lustre_all.yaml"  
      cluster_config: "{{ playbook_base }}/lustre/configure_cluster/configure_lustre_all.yaml"
      cluster_test: "{{ playbook_base }}/shared/ior_tester.yaml" # this one is optional
    system:
      type: 'lustre'
      version: '2.15.4'
      loglevel: '5'

    # The different types of groups that VMs can have in this system.
    # These will become ansible groups in the auto-generated inventories 
    # subsequently used with your user-custom playbooks. 
    vm_groups:
      cli_group: "clients"
      mds_group: "mds"
      oss_group: "oss"

    # define where images are stored
    image_storage:
      gold_iso: "/proj/mvpnet/images/alma/AlmaLinux-8.10-x86_64-minimal.iso"
      libvirt: "/mnt/local/{{ current_user }}/images"
      local_storage: "/mnt/local/{{ current_user }}"
      #gold_qcows: "/proj/mvpnet/images/{{ current_user }}"
      gold_qcows: "/mnt/local/{{ current_user }}/qcows/"

    # define the networking
    # networking needs to either have a private network or define wireguard values
    network:
      type: 'mvpnet' # can be 'private' or 'wireguard'. If 'private', then 'interface' must be defined. If 'wireguard', then 'wg_base_ip' and 'wg_cidr' must be defined
      libvirt:
        base_ip: "192.68.55"
        cidr: "24" # if type is wireguard, this must allow a single network to span multiple hosts (e.g. 28), if type is private, 24 is a good value
        default: "default" 
      mvpnet:
        base_ip: '10.0.0'
        device: 'ens3'
        user: '{{ current_user }}'
        host_interface: 'eno1np0'
        mpi_module: 'mpi/openmpi'
        path: '/usr/local/mvpnet/mpi_openmpi/bin/'
      interface: "eno2"
      wg_base_ip: "192.68.66"
      wg_cidr: 24

    # define what the gold VMs look like
    # note that you need to define an individual gold vm for each of your vm_groups
    gold_vms:
      defaults: # each default value can be overwritten in the individual entries
        iso: "{{ image_storage.gold_iso }}"
        machine: "pc-q35-rhel8.2.0"
        memory: 2048
        network:
          bootproto: "dhcp"
          default: "{{ network.libvirt.default }}" 
          device: "enp1s0"
          ipv6: "noipv6"
          ntpservers:
            - "0.pool.ntp.org"
            - "1.pool.ntp.org"
            - "2.pool.ntp.org"
            - "3.pool.ntp.org"
          onboot: "yes"
        os_variant: "almalinux8"
        root_pwd: "password"
        ssh_keys: '/users/{{ current_user }}/.ssh/authorized_keys'
        ssh_keypair: '/users/{{ current_user }}/.ssh/id_rsa'
        timezone: "US/Mountain"
        vcpu: 1
      individual:
        - name: "gold-{{ UNIQUE_TAG }}-{{ vm_groups.oss_group }}"
          disk_size: 12
          group: "{{ vm_groups.oss_group }}"
          vcpu: 2
        - name: "gold-{{ UNIQUE_TAG }}-{{ vm_groups.mds_group }}"
          disk_size: 20
          group: "{{ vm_groups.mds_group }}"
          vcpu: 2
        - name: "gold-{{ UNIQUE_TAG }}-{{ vm_groups.cli_group }}"
          disk_size: 8
          group: "{{ vm_groups.cli_group }}"
  
  # specify the lists of physical hosts across which the VMs will run
  # and the VMs which will run on each
  #
  # NOTE that EXTRA_HDDs will subsequently appear in /dev/disk/by-id/virtio-{{ $HOSTAME }}.{{ b-z }} 
  # where b means the first extra disk, c the second, etc.
  # This can be used in the config playbooks to know which devices to use for which mounts.
  children:
    physical_hosts:
      vars:
        user: "{{ lookup('env','USER') }}"
        domain_suffix: "centos.mvpnet"
        ansible_host: "{{ inventory_hostname }}.{{ domain_suffix }}"
      hosts:
        tessi0:
          vms:
            - [ lustre-mds00, "{{ vm_groups.mds_group }}", [10,10], 1 ]
            - [ lustre-oss00, "{{ vm_groups.oss_group }}", [10],    2 ]
        tessi1:
          vms:
            - [ lustre-mds01, "{{ vm_groups.mds_group }}", [10,10], 3 ]
            - [ lustre-oss01, "{{ vm_groups.oss_group }}", [10],    4 ]
        tessi2:
          vms:
            - [ lustre-mds02, "{{ vm_groups.mds_group }}", [10,10], 5 ]
            - [ lustre-oss02, "{{ vm_groups.oss_group }}", [10],    6 ]
        tessi3:
          vms:
            - [ lustre-mds03, "{{ vm_groups.mds_group }}", [10,10], 7 ]
            - [ lustre-oss03, "{{ vm_groups.oss_group }}", [10],    8 ]
        tessi4:
          vms:
            - [ lustre-cli01, "{{ vm_groups.cli_group }}", [],      9 ]
            - [ lustre-cli02, "{{ vm_groups.cli_group }}", [],     10 ]
            - [ lustre-cli03, "{{ vm_groups.cli_group }}", [],     11 ]
            - [ lustre-cli04, "{{ vm_groups.cli_group }}", [],     12 ]
        tessi5:
          vms:
            - [ lustre-cli05, "{{ vm_groups.cli_group }}", [],     13 ]
            - [ lustre-cli06, "{{ vm_groups.cli_group }}", [],     14 ]
            - [ lustre-cli07, "{{ vm_groups.cli_group }}", [],     15 ]
            - [ lustre-cli08, "{{ vm_groups.cli_group }}", [],     16 ]
