# note that the physical nodes are expected to be ubuntu 24.04
all:
  vars:
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    current_user: "{{ lookup('env', 'USER') }}"
    host_domain: "beegfs-{{ current_user }}.mvpnet"
    result_dir: '/proj/mvpnet/{{ current_user }}/experiments'
    local_storage: /mnt/local
    network:
      type: 'none'
    output_dir: "/tmp/{{ current_user }}/experiments" 
    playbooks:
      bootstrap_cluster: "./playbooks/shared/prereqs.yaml"
      gold_install: "./playbooks/beegfs/install_golds/install_beegfs_all.yaml"  
      cluster_config: "./playbooks/beegfs/configure_cluster/configure_beegfs.yaml"
      cluster_test: "./playbooks/shared/io500_tester.yaml" # this one is optional
    system:
      type: 'beegfs'
      version: '8.4'
    io500:
      stonewall_time: 300
      ppn: 8
    UNIQUE_TAG: "bphys"

  children:
    physical_hosts:
      vars:
        ansible_host: "{{ inventory_hostname }}.{{ host_domain }}"
      children:
        dservers:
          hosts:
            ds0:
            ds1:
            ds2:
            ds3:
            ds4:
            ds5:
            ds6:
            ds7:
            ds8:
            ds9:
        clients:
          hosts:
            cli0:
            cli1:
            cli2:
            cli3:
            cli4:
            cli5:
            cli6:
            cli7:
            cli8:
            cli9:
        mservers:
          hosts:
            mds0:
            mds1:
            mds2:
            mds3:
