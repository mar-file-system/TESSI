all:

  vars:

    # define a tag for this system to avoid collisions (e.g. on the gold VM images or the networking)
    UNIQUE_TAG: "intempt2"

    # optional directory into which to create the TASSI workflow (defaults to pwd/artifacts/UNIQUE_TAG)
    output_dir: "/tmp" # use tmp because the home dir has root squash

    # define paths to user-custom playbooks used in the 'install gold VMs' phase and the 'configure cluster' phase 
    playbooks:
      gold_install:   "/home/jbent/tassi/playbooks/empty/install.yaml"  
      cluster_config: "/home/jbent/tassi/playbooks/empty/config.yaml"
      cluster_test:   "/home/jbent/tassi/playbooks/shared/osu_tester.yaml" 

    # The different types of groups that VMs can have in this system.
    # These will become ansible groups in the auto-generated inventories 
    # subsequently used with your user-custom playbooks. 
    vm_groups:
      node_group: "n"

    # define where images are stored
    image_storage:
      qcow: "/mnt/usrc-storage-nfs/jbent/images"
      #libvirt: "/var/lib/libvirt/images"
      libvirt: "/mnt/nvme0n1/jbent/images"

    # define the networking
    # networking needs to either have a private network or define wireguard values
    network:
      type: 'mvpnet' # can be 'private' or 'wireguard'. If 'private', then 'interface' must be defined. If 'wireguard', then 'wg_base_ip' and 'wg_cidr' must be defined
      libvirt:
        base_ip: "192.68.55"
        cidr: "24" # if type is wireguard, this must allow a single network to span multiple hosts (e.g. 28), if type is private, 24 is a good value
        default: "default" 
      mvpnet:
        base_ip: '10.0.0'
        device: 'ens3'
        user: 'jbent'
        #host_interface: 'ibp193s0'
        host_interface: 'eno1'
        mpi_module: 'mpi/openmpi-x86_64'
        path: '/usr/local/mvpnet/mpi_openmpi-x86_64/bin/'
      interface: "eno2"
      wg_base_ip: "192.68.66"
      wg_cidr: 24

    # define what the gold VMs look like
    # note that you need to define an individual gold vm for each of your vm_groups
    gold_vms:
      defaults: # each default value can be overwritten in the individual entries
        iso: "{{ image_storage.qcow }}/alma/AlmaLinux-8.10-x86_64-minimal.iso"
        machine: "pc-q35-rhel8.2.0"
        memory: 2048
        network:
          bootproto: "dhcp"
          default: "{{ network.libvirt.default }}" 
          device: "enp1s0"
          ipv6: "noipv6"
          ntpservers:
            - "0.pool.ntp.org"
            - "1.pool.ntp.org"
            - "2.pool.ntp.org"
            - "3.pool.ntp.org"
          onboot: "yes"
        os_variant: "almalinux8"
        root_pwd: "password"
        ssh_keys: '/home/jbent/.ssh/authorized_keys'
        ssh_keypair: '/home/jbent/.ssh/id_rsa'
        system:
          type: 'lustre'
          version: '2.15.4'
          loglevel: '5'
        timezone: "US/Mountain"
        vcpu: 1
      individual:
        - name: "gold-{{ UNIQUE_TAG }}-{{ vm_groups.node_group }}"
          disk_size: 12
          group: "{{ vm_groups.node_group }}"
          vcpu: 2
  
  # specify the lists of physical hosts across which the VMs will run
  # and the VMs which will run on each
  #
  # NOTE that EXTRA_HDDs will subsequently appear in /dev/disk/by-id/virtio-{{ $HOSTAME }}.{{ b-z }} 
  # where b means the first extra disk, c the second, etc.
  # This can be used in the config playbooks to know which devices to use for which mounts.
  children:
    physical_hosts:
      hosts:
        in004:
          vms:
          # - [ NAME,            ROLE,                        [EXTRA_HDDs], IP_LAST_OCTET ]
            - [ n00, "{{ vm_groups.node_group }}", [], 1 ]
            - [ n01, "{{ vm_groups.node_group }}", [], 2 ]
            - [ n02, "{{ vm_groups.node_group }}", [], 3 ]
            - [ n03, "{{ vm_groups.node_group }}", [], 4 ]
        in008:
          vms:
            - [ n04, "{{ vm_groups.node_group }}", [], 5 ]
            - [ n05, "{{ vm_groups.node_group }}", [], 6 ]
            - [ n06, "{{ vm_groups.node_group }}", [], 7 ]
            - [ n07, "{{ vm_groups.node_group }}", [], 8 ]
        in019:
          vms:
            - [ n08, "{{ vm_groups.node_group }}", [], 9 ]
            - [ n09, "{{ vm_groups.node_group }}", [], 10 ]
            - [ n10, "{{ vm_groups.node_group }}", [], 11 ]
            - [ n11, "{{ vm_groups.node_group }}", [], 12 ]
        in007:
          vms:
            - [ n12, "{{ vm_groups.node_group }}", [], 13 ]
            - [ n13, "{{ vm_groups.node_group }}", [], 14 ]
            - [ n14, "{{ vm_groups.node_group }}", [], 15 ]
            - [ n15, "{{ vm_groups.node_group }}", [], 16 ]
